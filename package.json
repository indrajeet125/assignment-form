{
  "homepage": "https://indrajeet125.github.io/assignment-form",
  "name": "assignment-form1",
  "version": "0.1.0",
  "description": "A React feedback form with a local JSON Server API for creating, viewing, and deleting comments.",
  "private": true,
  "dependencies": {
    "axios": "^1.5.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "uuid": "^9.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "json-server": "json-server -p 3001 --w db.json",
    "startboth": "concurrently \"npm start\" \"npm run json-server\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^8.2.2",
    "gh-pages": "^6.3.0",
    "json-server": "^0.17.4",
    "react-scripts": "^5.0.1"
  }
}
